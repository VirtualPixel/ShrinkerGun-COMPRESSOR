<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>ShrinkerGun.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" PrivateAssets="all" />
  </ItemGroup>

  <!-- Compile the mod's pure helper straight in; the mod DLL itself needs BepInEx and
       the game at runtime, which a test host does not have. -->
  <ItemGroup>
    <Compile Include="../src/Services/BatteryMath.cs" Link="Services/BatteryMath.cs" />
  </ItemGroup>

</Project>
